# Copy to .env next to docker-compose.yml and fill in. Generate a secret with: openssl rand -hex 32
# Public port. 80 means the app opens as http://<server-ip> with no domain and no port in the URL.
HTTP_PORT=80
MONGO_PORT=27019

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Default users are created on first start only (when they don't exist yet).
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=مدیر سیستم
MARKETER_DEFAULT_USERNAME=marketer
MARKETER_DEFAULT_PASSWORD=
MARKETER_DEFAULT_NAME=بازاریاب آریو

# Optional: folder of a previous app's docker-compose.yml that deploy.sh should stop first. Leave empty to
# keep every other container on the server running.
OLD_APP_DIR=

# ---------------------------------------------------------------------------
# Beh-Pardakht Mellat internet gateway (درگاه اینترنتی بانک ملت)
# ---------------------------------------------------------------------------
# Leave MELLAT_ENABLED=false until the terminal is issued; the payment sheets hide themselves then.
MELLAT_ENABLED=false
# Numbers/letters exactly as Beh-Pardakht sent them in the contract letter.
MELLAT_TERMINAL_ID=
MELLAT_USER_NAME=
MELLAT_USER_PASSWORD=
# A Mellat terminal is normally cleared in RIALS. The shop books toman, so 1 toman = 10 gateway units.
# Set to "toman" only if your terminal really was configured in toman.
MELLAT_CURRENCY=rials
# The address the bank POSTs the customer back to. Leave empty to build it from the incoming request
# (it must stay under the domain registered for this terminal, otherwise the bank returns code 62).
MELLAT_CALLBACK_URL=
# Where the customer lands after the callback. Defaults to <same host>/tabs/invoices.
MELLAT_RETURN_URL=
# settings.bankCards id that online sales should be booked to (empty = no account tag).
MELLAT_ACCOUNT_ID=
# Shown on the bank page.
MELLAT_MERCHANT_NAME=فروشگاه آریو
# Public base URL of the app behind nginx; only needed when the proxy hides the host header.
PUBLIC_APP_URL=
