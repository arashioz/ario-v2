# Copy to .env next to docker-compose.yml and fill in. Generate a secret with: openssl rand -hex 32
# Public port. 80 means the app opens as http://<server-ip> with no domain and no port in the URL.
HTTP_PORT=80
MONGO_PORT=27019

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Default users are created on first start only (when they don't exist yet).
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_NAME=مدیر سیستم
MARKETER_DEFAULT_USERNAME=marketer
MARKETER_DEFAULT_PASSWORD=
MARKETER_DEFAULT_NAME=بازاریاب آریو

# Optional: folder of a previous app's docker-compose.yml that deploy.sh should stop first. Leave empty to
# keep every other container on the server running.
OLD_APP_DIR=
