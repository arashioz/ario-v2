PORT=3001
MONGODB_URI=mongodb://localhost:27019/ario_db
JWT_SECRET=ario_app_secret_jwt_key_2026_super_secure_key
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_NAME=مدیر سیستم
MARKETER_DEFAULT_USERNAME=marketer
MARKETER_DEFAULT_PASSWORD=marketer123
MARKETER_DEFAULT_NAME=بازاریاب آریو

# --- Beh-Pardakht Mellat internet gateway (درگاه اینترنتی بانک ملت) ---
# Terminal credentials come from the Beh-Pardakht contract letter. The server IP must be reported
# to Beh-Pardakht first, otherwise every SOAP call answers with code 421.
MELLAT_ENABLED=false
MELLAT_TERMINAL_ID=
MELLAT_USER_NAME=
MELLAT_USER_PASSWORD=
# rials (default, 1 toman = 10) or toman if the terminal was configured that way.
MELLAT_CURRENCY=rials
# Optional overrides; both are derived from the incoming request when empty.
MELLAT_CALLBACK_URL=
MELLAT_RETURN_URL=
# settings.bankCards id to book online sales to.
MELLAT_ACCOUNT_ID=
MELLAT_MERCHANT_NAME=فروشگاه آریو
PUBLIC_APP_URL=
