# ---------------------------------------------------------------------------
# HTTPS server for the Ario PWA. This is the FIX for geolocation: browsers
# only allow navigator.geolocation on a SECURE CONTEXT, and http://<ip> is NOT
# one. Serve the app over https://<your-domain> and GPS starts working in
# Android Chrome, the installed Android PWA, iOS Safari and the iOS Home-Screen
# PWA.
#
# HOW TO ENABLE (do not paste this into default.conf as-is until certs exist,
# otherwise `nginx -t` fails on missing ssl_certificate and the whole proxy
# dies at boot):
#
#   1. Point a real domain (e.g. ario.example.com) at this server. Certificates
#      cannot be issued for a bare IP by Let's Encrypt, so a domain is required.
#   2. Issue certs with an ACME client that can renew. Two common options:
#        # certbot standalone (stop nginx briefly) OR a webroot under /.well-known
#        certbot certonly --webroot -w /var/www/ario-certwebroot \
#                -d ario.example.com
#      Then copy the live certs into ./nginx/certs/ as:
#        ./nginx/certs/ario.example.com/fullchain.pem
#        ./nginx/certs/ario.example.com/privkey.pem
#   3. In docker-compose.yml, for the nginx service, ALSO:
#        ports:
#          - "443:443"
#        volumes:
#          - ./nginx/ariov2-ssl.conf:/etc/nginx/conf.d/ariov2-ssl.conf:ro   # rename .example -> .conf
#          - ./nginx/certs:/etc/nginx/certs:ro
#          - ario_certwebroot:/var/www/ario-certwebroot
#      and uncomment the certbot helper service at the bottom of this file.
#   4. Reload:  docker compose exec nginx nginx -t && docker compose exec nginx nginx -s reload
#
# Everything that worked before (HTTP on :80 in default.conf) is untouched; this
# only ADDS the secure origin. Keep the HTTP block: it is the ACME challenge
# landing point and the 80->443 redirect.
# ---------------------------------------------------------------------------

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ario.example.com;

    # ACME HTTP-01 challenge must be reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/ario-certwebroot;
    }

    # Send everything else to HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ario.example.com;

    ssl_certificate     /etc/nginx/certs/ario.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/ario.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 30m;

    # Same shared Permissions-Policy as the HTTP server. This is what keeps
    # geolocation=(self) available in the standalone PWA. NEVER geolocation=().
    include /etc/nginx/policies.conf;

    # HSTS is only set over TLS. Start with a short max-age, then raise it once
    # you are sure every subdomain you own also serves HTTPS.
    add_header Strict-Transport-Security "max-age=15552000" always;

    # Docker's DNS + re-resolve on restart (same trick as default.conf).
    resolver 127.0.0.11 ipv6=off valid=10s;

    location / {
        set $upstream app:3000;
        proxy_pass http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Hard-code "https" so the backend builds https callback/canonical URLs.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}

# Optional: auto-renew. Add this service to docker-compose.yml alongside nginx.
# services:
#   certbot:
#     image: certbot/certbot
#     container_name: ariov2_certbot
#     volumes:
#       - ./nginx/certs:/etc/letsencrypt
#       - ario_certwebroot:/var/www/ario-certwebroot
#     entrypoint: /bin/sh -c 'trap exit TERM; while :; do certbot renew --webroot -w /var/www/ario-certwebroot; sleep 12h & wait $${!}; done;'
